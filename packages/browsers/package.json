  },
  "devDependencies": {
    "@effect/tsgo": "0.67.7",
    "@spar/lint": "workspace:*",
    "@types/bun": "1.4.3",
    "oxfmt": "0.73.0",
    "oxlint": "1.91.0",
    "typescript": "7.0.2"
  }
}
