{
  "name": "@spar/sidebar",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "effect-tsgo tsrs -p tsconfig.json",
    "lint": "effect-tsgo --tsrs-lint oxlint -c ../../packages/lint/oxlintrc.json src server test scripts",
    "test": "bun --bun vitest run",
    "build": "vite build",
    "dev": "vite",
    "showcase": "bun run build && bun scripts/showcase.ts",
    "backend": "bun run build && bun scripts/backend.ts",
    "traced": "bun run build && bun ../../packages/browsers/scripts/in.ts bun scripts/traced.ts",
    "production": "bun run build && bun scripts/production.ts",
    "leaks": "bun run build && bun scripts/leaks.ts",
    "deep": "bun ../../packages/browsers/scripts/in.ts bun scripts/deep.ts",
    "devtools": "bun ../../packages/browsers/scripts/in.ts bun scripts/devtools.ts",
    "features": "bun run build && bun ../../packages/browsers/scripts/in.ts bun scripts/features.ts",
    "walkthrough": "bun run build && bun ../../packages/browsers/scripts/in.ts bun scripts/walkthrough.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@effect/platform-bun": "4.1.4",
    "@spar/ui": "workspace:*",
    "effect": "4.1.4",
    "spar": "workspace:*"
  },
  "devDependencies": {
    "@effect/tsgo": "0.67.7",
    "@effect/vitest": "4.1.4",
    "@spar/browsers": "workspace:*",
    "@spar/lint": "workspace:*",
    "@testing-library/dom": "10.4.1",
    "@types/bun": "1.4.3",
    "@vitest/coverage-istanbul": "5.0.5",
    "axe-core": "4.14.0",
    "happy-dom": "20.0.11",
    "oxfmt": "0.73.0",
    "oxlint": "1.91.0",
    "playwright": "1.65.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.0.5"
  }
}
