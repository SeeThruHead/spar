{
  "name": "@spar/ssr",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "effect-tsgo tsrs -p tsconfig.json",
    "lint": "effect-tsgo --tsrs-lint oxlint -c ../../packages/lint/oxlintrc.json src scripts",
    "build": "bun scripts/build.ts",
    "serve": "bun run build && bun scripts/serve.ts",
    "browser": "bun run build && bun ../../packages/browsers/scripts/in.ts bun scripts/browser-test.ts",
    "leaks": "bun run build && bun scripts/leaks.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "effect": "4.1.4",
    "spar": "workspace:*"
  },
  "devDependencies": {
    "@effect/tsgo": "0.67.7",
    "@spar/browsers": "workspace:*",
    "@spar/lint": "workspace:*",
    "@types/bun": "1.4.3",
    "oxfmt": "0.73.0",
    "oxlint": "1.91.0",
    "playwright": "1.65.1",
    "typescript": "7.0.2"
  }
}
